# copie este arquivo para .env; o .env NUNCA vai para o git.

DATABASE_URL=sqlite:///./todo_list.db

# --- Autenticação (JWT) ---

# Segredo que assina os tokens: minimo 32 caracteres, diferente em cada instalação.
# Gere um com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque_por_um_segredo_gerado
# Por quantos minutos um login continua valendo.
JWT_EXPIRA_MINUTOS=120